{
	"name": "@saude-bliss/automation",
	"version": "1.0.0",
	"private": true,
	"description": "Automação da conferência operacional de solicitações com Playwright",
	"scripts": {
		"test": "playwright test",
		"test:ui": "playwright test --ui",
		"test:headed": "playwright test --project=chromium-headed",
		"test:desktop": "playwright test --project=chromium-headless",
		"test:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
		"test:debug": "PWDEBUG=1 playwright test",
		"report": "playwright show-report reports/html",
		"install:browsers": "playwright install chromium webkit",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@saude-bliss/contracts": "workspace:*"
	},
	"devDependencies": {
		"@playwright/test": "^1.49.1",
		"@types/node": "^22.10.7",
		"dotenv": "^16.4.7",
		"typescript": "^5.7.3"
	}
}
