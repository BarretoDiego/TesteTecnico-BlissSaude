{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"baseUrl": ".",
		"noEmit": true,
		"isolatedModules": true,
		"module": "CommonJS",
		"moduleResolution": "Node",
		"paths": {
			"@saude-bliss/contracts": ["../../packages/contracts/src/index.ts"],
			"~/*": ["./src/*"]
