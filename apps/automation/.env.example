# Backoffice sob automação.
WEB_BASE_URL=http://localhost:3000

# API usada como **oráculo**: a suíte compara o que a tela mostra com o que a
# API devolve. É essa comparação que faz a conferência ser conferência, e não um
# roteiro de cliques.
API_BASE_URL=http://localhost:4000/v1

# Credencial de quem executa a conferência. Corresponde a um usuário do seed.
AUTOMATION_EMAIL=daniel.morais@saudebliss.test
AUTOMATION_PASSWORD=saudebliss123
