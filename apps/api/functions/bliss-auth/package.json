{
	"name": "@saude-bliss/bliss-auth",
	"version": "1.0.0",
	"private": true,
	"description": "Microserviço de autenticação — emite, renova e revoga sessões no API Gateway",
	"main": "src/app.ts",
	"scripts": {
		"build": "BLISS_ENV=local node build.js",
		"build:dev": "BLISS_ENV=dev node build.js",
		"build:stage": "BLISS_ENV=stage node build.js",
		"build:prod": "BLISS_ENV=prod node build.js",
		"test": "jest",
		"test:unit": "jest --selectProjects unit",
		"test:coverage": "jest --coverage",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@saude-bliss/contracts": "workspace:*",
		"@saude-bliss/core": "workspace:*",
		"@saude-bliss/database": "workspace:*",
		"drizzle-orm": "^0.45.2",
		"fastify": "^5.2.1",
		"jose": "^5.9.6",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@types/jest": "^29.5.14",
		"@types/node": "^22.10.7",
		"dotenv": "^16.4.7",
		"esbuild": "^0.24.2",
		"jest": "^29.7.0",
		"serverless": "3.40.0",
		"ts-jest": "^29.2.5",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.7.3"
	}
}
