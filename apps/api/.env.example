# =============================================================================
# apps/api — variáveis compartilhadas pelos microserviços
# Copie para `.env`. Em AWS/LocalStack elas vêm do Terraform e a credencial do
# banco vem do Secrets Manager (ver DB_SECRET_ID).
# =============================================================================

# local | dev | stage | prod
BLISS_ENV=local
LOG_LEVEL=debug
API_PREFIX=/v1

# Porta do modo agregado (run.all.local.ts) — vale só para ele.
PORT=4000
# Cada microserviço isolado usa a porta fixa dele (bliss-requests=4001,
# bliss-reviews=4002). SERVICE_PORT sobrescreve pontualmente, sem afetar o
# modo agregado — foi por herdar PORT que o serviço isolado subia na 4000.
# SERVICE_PORT=

# -----------------------------------------------------------------------------
# Banco de dados
# -----------------------------------------------------------------------------
# Precedência: DATABASE_URL vence sempre. É o escape hatch que aponta a Lambda
# para o Postgres do compose quando o RDS emulado do LocalStack der problema.
DATABASE_URL=postgresql://saudebliss:saudebliss@localhost:5433/saudebliss

# Alternativa em AWS/LocalStack: id do secret escrito pelo Terraform.
# DB_SECRET_ID=/local/saude-bliss/database/credentials

# Ver a aritmética de pool em packages/database/src/client.ts antes de mexer.
DB_POOL_MAX=1
# RDS exige TLS; Postgres local não.
DB_SSL=false

# -----------------------------------------------------------------------------
# AWS (preenchido pelo Terraform fora do ambiente local)
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
# Só no LocalStack — em AWS real deixe vazio para o SDK usar o endpoint padrão.
# AWS_ENDPOINT_URL=http://localhost:4568
