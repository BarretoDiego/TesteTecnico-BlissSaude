{
	"name": "@saude-bliss/api",
	"version": "1.0.0",
	"private": true,
	"description": "API de gestão de solicitações — Fastify sobre AWS Lambda",
	"main": "src/app.ts",
	"scripts": {
		"dev": "ts-node-dev -r tsconfig-paths/register --respawn --transpile-only --ignore-watch node_modules run.local.ts",
		"build": "node build.js",
		"build:local": "SB_ENV=local node build.js",
		"package": "serverless package --stage local",
		"offline": "serverless offline --stage local",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "ts-node -r tsconfig-paths/register src/db/migrate.ts",
		"db:seed": "ts-node -r tsconfig-paths/register src/db/seed.ts",
		"db:studio": "drizzle-kit studio",
		"test": "jest",
		"test:unit": "jest --selectProjects unit",
		"test:integration": "jest --selectProjects integration",
		"test:contract": "jest --selectProjects contract",
		"test:e2e": "jest --selectProjects e2e",
		"test:coverage": "jest --coverage",
		"check:routes": "ts-node scripts/check-route-parity.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@aws-sdk/client-secrets-manager": "^3.750.0",
		"@fastify/aws-lambda": "^5.1.4",
		"@fastify/cors": "^11.0.1",
		"@fastify/swagger": "^9.5.1",
		"@fastify/swagger-ui": "^5.2.2",
		"@saude-bliss/contracts": "workspace:*",
		"drizzle-orm": "^0.45.2",
		"fastify": "^5.2.1",
		"pg": "^8.13.1",
		"zod": "^3.25.76",
		"zod-to-json-schema": "^3.24.1"
	},
	"devDependencies": {
		"@types/jest": "^29.5.14",
		"@types/node": "^22.10.7",
		"@types/pg": "^8.11.10",
		"aws-sdk-client-mock": "^4.1.0",
		"dotenv": "^16.4.7",
		"drizzle-kit": "^0.31.10",
		"esbuild": "^0.24.2",
		"jest": "^29.7.0",
		"serverless": "3.40.0",
		"serverless-offline": "13.10.0",
		"ts-jest": "^29.2.5",
		"ts-node": "^10.9.2",
		"ts-node-dev": "^2.0.0",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.7.3",
		"yaml": "^2.7.0"
	}
}
