{
	"name": "@saude-bliss/database",
	"version": "1.0.0",
	"private": true,
	"description": "Schema Drizzle, client de conex\u00e3o, migrations e seed \u2014 compartilhados por todos os microservi\u00e7os",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"scripts": {
		"db:generate": "drizzle-kit generate",
		"db:migrate": "ts-node -r tsconfig-paths/register src/migrate.ts",
		"db:seed": "ts-node -r tsconfig-paths/register src/seed.ts",
		"db:studio": "drizzle-kit studio",
		"typecheck": "tsc --noEmit",
		"test": "jest",
		"test:coverage": "jest --coverage"
	},
	"dependencies": {
		"@saude-bliss/contracts": "workspace:*",
		"@saude-bliss/core": "workspace:*",
		"drizzle-orm": "^0.45.2",
		"pg": "^8.13.1"
	},
	"devDependencies": {
		"@types/jest": "^29.5.14",
		"@types/node": "^22.10.7",
		"@types/pg": "^8.11.10",
		"dotenv": "^16.4.7",
		"drizzle-kit": "^0.31.10",
		"jest": "^29.7.0",
		"ts-jest": "^29.2.5",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.7.3"
	}
}
