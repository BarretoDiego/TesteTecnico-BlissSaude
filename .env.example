# =============================================================================
# Saúde Bliss — variáveis de ambiente do monorepo (raiz)
# Copie para `.env` (`cp .env.example .env`) e preencha antes de subir o compose.
# Cada app tem seu próprio `.env.example` para variáveis específicas.
# =============================================================================

# -----------------------------------------------------------------------------
# LocalStack
# -----------------------------------------------------------------------------
# Imagem do LocalStack, fixada na v3: as imagens `latest` de 2026 exigem token
# mesmo para os serviços gratuitos e abortam sem ele. A v3 cobre tudo o que este
# projeto usa. Ver o comentário no docker-compose.yml.
LOCALSTACK_IMAGE=localstack/localstack:3

# Token de licença. Opcional: preencha e troque LOCALSTACK_IMAGE para
# `localstack/localstack-pro:latest` para exercitar o RDS emulado.
# https://app.localstack.cloud/workspace/auth-token
LOCALSTACK_AUTH_TOKEN=

# Serviços emulados. Acrescente `rds` só junto com a imagem Pro e o token — pedir
# um serviço Pro sem licença faz o container abortar na inicialização.
# LOCALSTACK_SERVICES=apigateway,lambda,secretsmanager,iam,logs,cloudwatch,sts,s3,events,sqs,rds

# Porta do gateway do LocalStack no host.
# 4568 (e não a 4566 padrão) porque outra instância de LocalStack pode já estar
# rodando na máquina. Sempre use scripts/localstack/aws.sh em vez de `awslocal`,
# que assume 4566 e silenciosamente acertaria a instância errada.
LOCALSTACK_PORT=4568

# Rede docker onde as Lambdas do LocalStack são executadas. Precisa ser a mesma
# rede do compose para que a Lambda enxergue o Postgres pelo nome do serviço.
LAMBDA_DOCKER_NETWORK=saude-bliss_default

# -----------------------------------------------------------------------------
# Postgres local (fallback do RDS emulado — ver `use_localstack_rds` no Terraform)
# -----------------------------------------------------------------------------
POSTGRES_USER=saudebliss
POSTGRES_PASSWORD=saudebliss
POSTGRES_DB=saudebliss
# 5433 no host para não colidir com um Postgres já instalado na 5432.
POSTGRES_PORT=5433
