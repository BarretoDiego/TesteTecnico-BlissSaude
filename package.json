{
	"name": "saude-bliss",
	"version": "1.0.0",
	"private": true,
	"description": "Gestão de solicitações — API serverless (Node + TypeScript + Serverless Framework + Terraform) e automação de conferência com Playwright",
	"packageManager": "pnpm@10.30.0",
	"engines": {
		"node": ">=22 <23"
	},
	"scripts": {
		"start": "./scripts/start.sh",
		"stop": "./scripts/stop.sh",
		"restart": "./scripts/stop.sh && ./scripts/start.sh",
		"reset": "./scripts/stop.sh --limpar && ./scripts/start.sh",
		"urls": "./scripts/urls.sh",
		"resources": "./scripts/resources.sh",
		"logs": "./scripts/logs.sh",
		"verify": "./scripts/verify-all.sh",
		"verify:rapido": "./scripts/verify-all.sh --rapido",
		"smoke": "./scripts/localstack/smoke.sh",
		"deploy:sls": "./scripts/serverless/deploy.sh",
		"deploy:sls:remove": "./scripts/serverless/deploy.sh --remover",
		"evidence": "./scripts/evidence/capture.sh",
		"infra:up": "docker compose up -d && ./scripts/localstack/wait-ready.sh",
		"infra:down": "docker compose down",
		"infra:reset": "docker compose down -v && docker compose up -d && ./scripts/localstack/wait-ready.sh",
		"dev:api": "pnpm --filter @saude-bliss/api dev",
		"dev:web": "pnpm --filter @saude-bliss/web dev",
		"build": "pnpm --filter @saude-bliss/api build && pnpm --filter @saude-bliss/web build",
		"test": "pnpm --filter @saude-bliss/api test",
		"test:coverage": "pnpm --filter @saude-bliss/api test:coverage",
		"test:e2e": "pnpm --filter @saude-bliss/automation test",
		"test:e2e:ui": "pnpm --filter @saude-bliss/automation test:ui",
		"test:e2e:report": "pnpm --filter @saude-bliss/automation report",
		"check:routes": "pnpm --filter @saude-bliss/api check:routes",
		"db:migrate": "pnpm --filter @saude-bliss/database db:migrate",
		"db:seed": "pnpm --filter @saude-bliss/database db:seed",
		"typecheck": "pnpm -r typecheck",
		"deploy:local": "./scripts/localstack/deploy.sh",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"clean": "rm -rf apps/api/functions/*/dist apps/web/.next apps/automation/{reports,test-results} packages/*/coverage apps/api/functions/*/coverage",
		"clean:all": "pnpm clean && rm -rf node_modules apps/*/node_modules apps/api/functions/*/node_modules packages/*/node_modules infra/terraform/.terraform"
	},
	"devDependencies": {
		"prettier": "^3.4.2",
		"prettier-plugin-organize-imports": "^4.1.0",
		"typescript": "^5.7.3"
	},
	"pnpm": {
		"//": "esbuild precisa do postinstall para baixar o binário nativo da plataforma.",
		"onlyBuiltDependencies": [
			"esbuild"
		]
	}
}
